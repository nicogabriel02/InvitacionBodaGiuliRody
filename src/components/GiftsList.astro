---
---

<div class="w-full max-w-5xl mx-auto px-4 py-8 relative">
    <!-- Overlay de Carga -->
    <div id="loadingOverlay" class="absolute inset-0 z-10 flex flex-col items-center justify-center bg-boda-beige/90 backdrop-blur-sm rounded-2xl min-h-[400px]">
        <div class="animate-spin rounded-full h-12 w-12 border-4 border-boda-brown/30 border-t-boda-brown mb-4"></div>
        <p class="font-sans text-boda-navy font-medium tracking-widest text-sm uppercase animate-pulse">Cargando regalos...</p>
    </div>

    <!-- Header & Description -->
    <div class="text-center mb-10">
        <p class="font-sans text-boda-navy/80 max-w-2xl mx-auto leading-relaxed text-sm md:text-base">
            “Lo más importante para nosotros es compartir este día con vos.
            Si querés hacernos un regalo para nuestro hogar, podés elegir algo de nuestra lista a continuación o colaborar con un aporte parcial. ¡Gracias por acompañarnos!” ✨
        </p>
    </div>

    <!-- Search & Filter Controls -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 mb-8">
        <div class="relative w-full md:w-72">
            <input 
                type="text" 
                id="giftSearch" 
                placeholder="Buscar regalo..." 
                class="w-full pl-10 pr-4 py-2.5 rounded-full bg-white/90 border border-boda-brown/20 focus:outline-none focus:border-boda-brown text-sm font-sans placeholder:text-boda-navy/40 shadow-sm transition-all"
            />
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3.5 top-3.5 text-boda-brown/60" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>

        <div class="flex flex-wrap justify-center gap-2 text-xs font-sans" id="filterContainer">
            <button class="filter-btn active px-4 py-2 rounded-full border border-boda-brown text-boda-brown hover:bg-boda-brown hover:text-white transition-all shadow-sm font-medium" data-filter="all">Todos</button>
            <button class="filter-btn px-4 py-2 rounded-full border border-boda-brown/30 text-boda-navy hover:border-boda-brown hover:text-boda-brown transition-all shadow-sm font-medium" data-filter="available">Incompletos</button>
            <button class="filter-btn px-4 py-2 rounded-full border border-boda-brown/30 text-boda-navy hover:border-boda-brown hover:text-boda-brown transition-all shadow-sm font-medium" data-filter="completed">Completados</button>
        </div>
    </div>

    <!-- Gifts Grid (Rendered by JS) -->
    <div id="giftsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Tarjetas generadas dinámicamente -->
    </div>

    <!-- Empty State -->
    <div id="noResults" class="hidden text-center py-16">
        <p class="font-serif text-2xl text-boda-brown mb-2">No encontramos regalos</p>
        <p class="font-sans text-sm text-boda-navy/60">Probá buscando con otras palabras o cambiando los filtros.</p>
    </div>
</div>

<!-- Modal de Reserva / Aporte -->
<div id="giftModal" class="fixed inset-0 z-[60] flex items-center justify-center bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl relative transform scale-95 transition-transform duration-300 max-h-[90vh] overflow-y-auto border border-boda-brown/20">
        <button id="closeModal" class="absolute top-5 right-5 text-boda-navy/50 hover:text-boda-navy p-2 rounded-full hover:bg-boda-beige/40 transition-colors z-10">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>

        <!-- Step 1: Formulario -->
        <div id="modalStep1">
            <h2 id="modalTitle" class="font-serif text-2xl text-boda-brown mb-4">Aportar al regalo</h2>
            
            <div class="flex items-center gap-4 mb-6 bg-boda-beige/10 p-3 rounded-xl border border-boda-brown/10">
                <img id="modalGiftImage" src="" alt="Gift" class="w-16 h-16 object-contain rounded-lg bg-white p-1 border border-boda-brown/10 shrink-0 shadow-sm" />
                <div class="flex-1 min-w-0">
                    <h3 id="modalGiftTitle" class="font-sans text-sm font-medium text-boda-navy line-clamp-2 leading-tight"></h3>
                    <div class="mt-2 text-xs font-sans text-boda-navy/70 flex justify-between">
                        <span id="modalGiftProgressText"></span>
                        <span id="modalGiftPrice" class="font-bold text-boda-brown"></span>
                    </div>
                    <!-- Mini progress bar -->
                    <div class="w-full bg-boda-beige/50 rounded-full h-1.5 mt-1 overflow-hidden">
                        <div id="modalGiftProgressBar" class="bg-boda-brown h-1.5 rounded-full transition-all duration-500"></div>
                    </div>
                </div>
            </div>

            <form id="contributionForm" class="space-y-4">
                <div>
                    <label class="block font-sans text-xs font-semibold text-boda-navy uppercase tracking-wider mb-1">Tu Nombre y Apellido *</label>
                    <input 
                        type="text" 
                        id="guestName" 
                        required 
                        placeholder="Ej: María García" 
                        class="w-full px-4 py-3 rounded-xl bg-boda-beige/20 border border-boda-brown/20 focus:outline-none focus:border-boda-brown text-sm font-sans text-boda-navy"
                    />
                </div>

                <div id="amountContainer">
                    <label class="block font-sans text-xs font-semibold text-boda-navy uppercase tracking-wider mb-1">Monto a aportar (ARS) *</label>
                    <div class="relative">
                        <span class="absolute left-4 top-3 text-boda-navy/50 font-sans">$</span>
                        <input 
                            type="number" 
                            id="contributionAmount" 
                            required 
                            min="1000"
                            placeholder="0" 
                            class="w-full pl-8 pr-4 py-3 rounded-xl bg-boda-beige/20 border border-boda-brown/20 focus:outline-none focus:border-boda-brown text-sm font-sans text-boda-navy"
                        />
                    </div>
                    <p id="amountHelperText" class="text-[11px] text-boda-navy/60 font-sans mt-1">Monto mínimo: $1.000</p>
                </div>

                <div>
                    <label class="block font-sans text-xs font-semibold text-boda-navy uppercase tracking-wider mb-1">Mensaje para Giuli y Rody (Opcional)</label>
                    <textarea 
                        id="guestMessage" 
                        rows="2" 
                        placeholder="¡Felicidades chicos!..." 
                        class="w-full px-4 py-3 rounded-xl bg-boda-beige/20 border border-boda-brown/20 focus:outline-none focus:border-boda-brown text-sm font-sans text-boda-navy"
                    ></textarea>
                </div>

                <div class="pt-2">
                    <button 
                        type="submit" 
                        id="submitBtn"
                        class="w-full py-4 bg-boda-brown text-white rounded-full font-sans text-xs font-bold tracking-widest uppercase hover:bg-boda-navy transition-all shadow-lg flex items-center justify-center gap-2"
                    >
                        <span>Continuar</span>
                        <svg id="submitSpinner" class="animate-spin -ml-1 mr-3 h-4 w-4 text-white hidden" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </button>
                </div>
            </form>
        </div>

        <!-- Step 2: Confirmación y Datos Bancarios -->
        <div id="modalStep2" class="hidden text-center space-y-6">
            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-inner">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
            </div>

            <div>
                <h3 class="font-serif text-2xl text-boda-brown mb-2">¡Casi listo, <span id="confirmedName"></span>!</h3>
                <p class="font-sans text-sm text-boda-navy/80">
                    Tu aporte de <strong id="confirmedAmount" class="text-boda-navy"></strong> fue registrado.
                </p>
                <p class="font-sans text-xs text-boda-navy/60 mt-1">
                    Para finalizar, realizá la transferencia y envianos el comprobante por WhatsApp.
                </p>
            </div>

            <div class="bg-boda-beige/30 p-5 rounded-2xl text-left border border-boda-brown/20 space-y-2 font-sans text-xs text-boda-navy relative">
                <p class="font-bold text-boda-brown text-sm mb-2 text-center uppercase tracking-wider">Datos para Transferir</p>
                <p><strong>Titular:</strong> Giulieta Ariana Ciuffardi Lemos</p>
                <p class="flex items-center justify-between">
                    <span><strong>Alias:</strong> <code class="font-mono bg-white px-2 py-0.5 rounded text-boda-brown border border-boda-brown/10">casamiento.giu.ro</code></span>
                    <button type="button" class="copy-modal-data text-boda-brown hover:text-boda-navy font-semibold text-[11px] uppercase tracking-wide bg-white px-2 py-1 rounded shadow-sm border border-boda-brown/10 transition-colors" data-copy="casamiento.giu.ro">Copiar</button>
                </p>
                <p class="flex items-center justify-between">
                    <span><strong>CBU:</strong> <code class="font-mono text-[11px] bg-white px-1.5 py-0.5 rounded border border-boda-brown/10">1430001713042921950019</code></span>
                    <button type="button" class="copy-modal-data text-boda-brown hover:text-boda-navy font-semibold text-[11px] uppercase tracking-wide bg-white px-2 py-1 rounded shadow-sm border border-boda-brown/10 transition-colors" data-copy="1430001713042921950019">Copiar</button>
                </p>
                <div class="mt-4 pt-3 border-t border-boda-brown/10 flex justify-between items-center">
                    <span class="text-sm">Total a transferir:</span>
                    <span id="confirmedTotal" class="font-bold text-lg text-boda-brown"></span>
                </div>
            </div>

            <div>
                <a 
                    id="whatsappLink" 
                    href="#" 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="inline-flex items-center justify-center gap-2 w-full py-4 bg-emerald-600 text-white rounded-full font-sans text-xs font-bold tracking-widest uppercase hover:bg-emerald-700 transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
                >
                    <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
                    </svg>
                    Enviar Comprobante
                </a>
            </div>
            
            <button id="finishBtn" class="text-xs font-sans text-boda-navy/50 hover:text-boda-brown underline transition-colors">
                Cerrar y volver a la lista
            </button>
        </div>
    </div>
</div>

<script>
    import { supabase } from '../lib/supabase';

    let giftsData = [];
    let giftProgressMap = {};
    let currentFilter = 'all';
    let searchQuery = '';
    
    // Modal state
    let currentGift = null;
    let isFullPurchaseMode = false;

    // Formatting utilities
    const formatMoney = (amount) => {
        return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS', maximumFractionDigits: 0 }).format(amount);
    };

    // Load Data
    async function loadGifts() {
        try {
            // 1. Fetch gifts
            const { data: gifts, error: giftsError } = await supabase.from('gifts').select('*').order('price', { ascending: true });
            if (giftsError) throw giftsError;
            
            // 2. Fetch all contributions
            const { data: contributions, error: contribError } = await supabase.from('contributions').select('gift_id, amount');
            if (contribError) throw contribError;

            // 3. Compute Spill-over (Sobrante) Logic
            let generalPool = 0;
            let tempProgress = {};

            // Init progress
            gifts.forEach(g => {
                tempProgress[g.id] = { price: Number(g.price), funded: 0 };
            });

            // Assign direct contributions
            contributions.forEach(c => {
                const amt = Number(c.amount);
                if (c.gift_id && tempProgress[c.gift_id]) {
                    tempProgress[c.gift_id].funded += amt;
                } else {
                    generalPool += amt;
                }
            });

            // Cap at price and send excess to pool
            gifts.forEach(g => {
                const prog = tempProgress[g.id];
                if (prog.funded > prog.price) {
                    generalPool += (prog.funded - prog.price);
                    prog.funded = prog.price;
                }
            });

            // Distribute general pool to incomplete gifts (sorted by closest to complete)
            let incompleteGifts = gifts.filter(g => tempProgress[g.id].funded < tempProgress[g.id].price);
            incompleteGifts.sort((a, b) => {
                let pA = tempProgress[a.id].funded / tempProgress[a.id].price;
                let pB = tempProgress[b.id].funded / tempProgress[b.id].price;
                return pB - pA;
            });

            for (let g of incompleteGifts) {
                if (generalPool <= 0) break;
                let remaining = tempProgress[g.id].price - tempProgress[g.id].funded;
                if (generalPool >= remaining) {
                    tempProgress[g.id].funded += remaining;
                    generalPool -= remaining;
                } else {
                    tempProgress[g.id].funded += generalPool;
                    generalPool = 0;
                    break;
                }
            }

            giftsData = gifts;
            giftProgressMap = tempProgress;
            
            // Remove loader and render
            document.getElementById('loadingOverlay').classList.add('hidden');
            renderGifts();

        } catch (error) {
            console.error("Error al cargar regalos:", error);
            document.getElementById('loadingOverlay').innerHTML = `<p class="text-red-500 font-sans">Hubo un error al cargar la lista. Por favor, recargá la página.</p>`;
        }
    }

    // Render logic
    function renderGifts() {
        const grid = document.getElementById('giftsGrid');
        const noResults = document.getElementById('noResults');
        grid.innerHTML = '';
        
        let visibleCount = 0;

        giftsData.forEach(gift => {
            const progress = giftProgressMap[gift.id];
            const isCompleted = progress.funded >= progress.price;
            const percentage = Math.min(100, Math.round((progress.funded / progress.price) * 100));
            const remaining = progress.price - progress.funded;

            // Filters
            if (currentFilter === 'available' && isCompleted) return;
            if (currentFilter === 'completed' && !isCompleted) return;
            if (searchQuery && !gift.title.toLowerCase().includes(searchQuery)) return;

            visibleCount++;

            const card = document.createElement('div');
            card.className = `gift-card bg-white rounded-2xl overflow-hidden shadow-md border flex flex-col justify-between transition-all duration-300 hover:shadow-xl hover:-translate-y-1 ${isCompleted ? 'border-emerald-200 bg-emerald-50/30' : 'border-boda-brown/10'}`;
            
            // Status badge logic
            let badgeHtml = '';
            if (isCompleted) {
                badgeHtml = `<span class="absolute top-3 right-3 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase shadow-sm bg-emerald-100 text-emerald-800 border border-emerald-200 backdrop-blur-sm">Completado</span>`;
            } else if (percentage > 0) {
                badgeHtml = `<span class="absolute top-3 right-3 px-3 py-1 rounded-full text-[10px] font-bold tracking-wider uppercase shadow-sm bg-amber-100 text-amber-800 border border-amber-200 backdrop-blur-sm">${percentage}% Financiado</span>`;
            }

            card.innerHTML = `
                <div class="relative aspect-square bg-white flex items-center justify-center p-6 border-b border-boda-brown/5 group">
                    <img src="${gift.image}" alt="${gift.title}" class="w-full h-full object-contain transition-transform duration-500 ${isCompleted ? 'opacity-50 grayscale' : 'group-hover:scale-105'}" loading="lazy" />
                    ${badgeHtml}
                </div>
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <h4 class="font-sans text-sm font-semibold text-boda-navy line-clamp-2 mb-1" title="${gift.title}">
                            ${gift.title}
                        </h4>
                        <div class="flex justify-between items-end mb-3">
                            <p class="font-serif text-xl font-bold text-boda-brown">${formatMoney(gift.price)}</p>
                        </div>
                        
                        <!-- Progress Bar -->
                        <div class="w-full bg-boda-beige/40 rounded-full h-2 mb-1 overflow-hidden">
                            <div class="bg-boda-brown h-2 rounded-full transition-all duration-1000" style="width: ${percentage}%"></div>
                        </div>
                        <p class="text-[10px] text-boda-navy/60 font-sans text-right uppercase tracking-wider mb-4">
                            Faltan ${formatMoney(remaining)}
                        </p>
                    </div>

                    <!-- Actions -->
                    <div class="flex flex-col gap-2">
                        ${isCompleted ? 
                            `<div class="w-full py-3 bg-emerald-50 text-emerald-600 rounded-xl font-sans text-xs font-bold tracking-widest uppercase text-center border border-emerald-200 shadow-sm flex items-center justify-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                                Regalo Logrado
                            </div>` 
                            : 
                            `<button class="btn-aportar w-full py-2.5 bg-white border border-boda-brown text-boda-brown rounded-xl font-sans text-xs font-bold tracking-widest uppercase hover:bg-boda-brown hover:text-white transition-colors shadow-sm" data-id="${gift.id}">
                                Aportar Monto
                            </button>
                            <button class="btn-regalar w-full py-2.5 bg-boda-brown text-white rounded-xl font-sans text-xs font-bold tracking-widest uppercase hover:bg-boda-navy transition-colors shadow-sm" data-id="${gift.id}">
                                Regalar Completo
                            </button>`
                        }
                        <a href="${gift.url}" target="_blank" rel="noopener noreferrer" class="text-center text-[10px] font-sans text-boda-navy/50 hover:text-boda-brown transition-colors py-1 mt-1">
                            Ver producto original ↗
                        </a>
                    </div>
                </div>
            `;
            grid.appendChild(card);
        });

        if (visibleCount === 0) {
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }

        attachEventListeners();
    }

    // Modal & Interactions
    const modal = document.getElementById('giftModal');
    
    // Move modal to body to prevent transform parent issues (stacking context)
    if (modal && modal.parentElement !== document.body) {
        document.body.appendChild(modal);
    }
    
    const closeModalBtn = document.getElementById('closeModal');
    const form = document.getElementById('contributionForm');
    const amountInput = document.getElementById('contributionAmount');
    
    function attachEventListeners() {
        document.querySelectorAll('.btn-aportar').forEach(btn => {
            btn.addEventListener('click', (e) => openModal(e.target.dataset.id, false));
        });
        document.querySelectorAll('.btn-regalar').forEach(btn => {
            btn.addEventListener('click', (e) => openModal(e.target.dataset.id, true));
        });
    }

    function openModal(id, fullPurchase) {
        currentGift = giftsData.find(g => g.id === id);
        if (!currentGift) return;

        const progress = giftProgressMap[id];
        const remaining = progress.price - progress.funded;
        isFullPurchaseMode = fullPurchase;

        // Reset UI
        document.getElementById('modalStep1').classList.remove('hidden');
        document.getElementById('modalStep2').classList.add('hidden');
        form.reset();
        document.getElementById('submitSpinner').classList.add('hidden');
        document.getElementById('submitBtn').disabled = false;

        // Set Data
        document.getElementById('modalGiftImage').src = currentGift.image;
        document.getElementById('modalGiftTitle').textContent = currentGift.title;
        document.getElementById('modalGiftPrice').textContent = formatMoney(currentGift.price);
        document.getElementById('modalTitle').textContent = fullPurchase ? 'Regalar Completo' : 'Aportar al regalo';
        
        const percentage = Math.min(100, Math.round((progress.funded / progress.price) * 100));
        document.getElementById('modalGiftProgressBar').style.width = `${percentage}%`;
        document.getElementById('modalGiftProgressText').textContent = `${percentage}% financiado`;

        if (fullPurchase) {
            document.getElementById('amountContainer').classList.add('hidden');
            amountInput.removeAttribute('required');
            amountInput.value = remaining; // internally store remaining
        } else {
            document.getElementById('amountContainer').classList.remove('hidden');
            amountInput.setAttribute('required', 'true');
            amountInput.value = '';
            amountInput.max = remaining;
            document.getElementById('amountHelperText').textContent = `Monto mínimo: $1.000 - Máximo sugerido: ${formatMoney(remaining)}`;
        }

        // Show Modal
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.firstElementChild?.classList.remove('scale-95');
        modal.firstElementChild?.classList.add('scale-100');
    }

    function hideModal() {
        modal.classList.add('opacity-0', 'pointer-events-none');
        modal.firstElementChild?.classList.remove('scale-100');
        modal.firstElementChild?.classList.add('scale-95');
        setTimeout(() => {
            // refresh data after closing if we submitted
            if (!document.getElementById('modalStep2').classList.contains('hidden')) {
                document.getElementById('loadingOverlay').classList.remove('hidden');
                loadGifts();
            }
        }, 300);
    }

    closeModalBtn.addEventListener('click', hideModal);
    document.getElementById('finishBtn').addEventListener('click', hideModal);
    modal.addEventListener('click', (e) => {
        if (e.target === modal) hideModal();
    });

    // Form Submit (Save to Supabase)
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentGift) return;

        const name = document.getElementById('guestName').value.trim();
        const message = document.getElementById('guestMessage').value.trim();
        const amount = isFullPurchaseMode ? 
            (giftProgressMap[currentGift.id].price - giftProgressMap[currentGift.id].funded) : 
            parseFloat(amountInput.value);

        if (!name || isNaN(amount) || amount <= 0) return;

        // Loading state
        const submitBtn = document.getElementById('submitBtn');
        const spinner = document.getElementById('submitSpinner');
        submitBtn.disabled = true;
        spinner.classList.remove('hidden');

        try {
            // Insert into Supabase
            const { error } = await supabase.from('contributions').insert([
                {
                    gift_id: currentGift.id,
                    guest_name: name,
                    amount: amount,
                    message: message || null
                }
            ]);

            if (error) throw error;

            // Success UI update
            document.getElementById('confirmedName').textContent = name;
            document.getElementById('confirmedAmount').textContent = formatMoney(amount);
            document.getElementById('confirmedTotal').textContent = formatMoney(amount);

            // WhatsApp Link setup with new number
            const text = encodeURIComponent(
                `¡Hola Giuli y Rody! Mi nombre es ${name}. Acabo de realizar un ${isFullPurchaseMode ? 'regalo completo' : 'aporte'} por ${formatMoney(amount)} para "${currentGift.title}". ¡Acá les envío el comprobante de transferencia! ✨`
            );
            // NEW NUMBER AS REQUESTED: +54 9 3813 33-3233
            document.getElementById('whatsappLink').href = `https://wa.me/5493813333233?text=${text}`;

            document.getElementById('modalStep1').classList.add('hidden');
            document.getElementById('modalStep2').classList.remove('hidden');

        } catch (error) {
            console.error("Error saving contribution:", error);
            alert("Hubo un error al registrar tu aporte. Por favor intentá nuevamente.");
        } finally {
            submitBtn.disabled = false;
            spinner.classList.add('hidden');
        }
    });

    // Copy to clipboard in modal
    document.querySelectorAll('.copy-modal-data').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            const text = e.target.getAttribute('data-copy');
            await navigator.clipboard.writeText(text);
            const originalText = e.target.textContent;
            e.target.textContent = '¡Copiado!';
            e.target.classList.add('text-emerald-600');
            setTimeout(() => {
                e.target.textContent = originalText;
                e.target.classList.remove('text-emerald-600');
            }, 2000);
        });
    });

    // Search & Filter
    document.getElementById('giftSearch')?.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        renderGifts();
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            document.querySelectorAll('.filter-btn').forEach(b => {
                b.classList.remove('bg-boda-brown', 'text-white');
                b.classList.add('text-boda-navy', 'border-boda-brown/30');
            });
            e.target.classList.add('bg-boda-brown', 'text-white');
            e.target.classList.remove('text-boda-navy', 'border-boda-brown/30');
            currentFilter = e.target.getAttribute('data-filter');
            renderGifts();
        });
    });

    // Initialize
    loadGifts();
</script>
